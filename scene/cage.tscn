[sub_resource type="GDScript" id="GDScript_hatau"]
script/source = "extends Area2D

@onready var animated_sprite: AnimatedSprite2D = $AnimatedSprite2D

func _ready() -> void:
	body_entered.connect(_on_body_entered)

func _on_body_entered(body: Node2D) -> void:
	# Check if the player entered the cage
	if body.is_in_group(\"player\") or body.name == \"player\":
		if body.has_method(\"get_trapped\"):
			# Trap the player and pass a reference to this cage
			body.get_trapped(self)
			# Play the close animation when player gets trapped
			if animated_sprite and animated_sprite.sprite_frames.has_animation(\"close\"):
				animated_sprite.play(\"close\")

func open_cage() -> void:
	# Play the open animation when the player escapes
	if animated_sprite and animated_sprite.sprite_frames.has_animation(\"open\"):
		animated_sprite.play(\"open\")
"

