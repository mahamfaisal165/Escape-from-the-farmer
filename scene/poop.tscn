[sub_resource type="GDScript" id="GDScript_6oufa"]
script/source = "extends Area2D

@onready var weapon_sound: AudioStreamPlayer2D = $WeaponSound

@export var speed: float = 450.0
var direction: Vector2 = Vector2.ZERO

func setup(dir: Vector2) -> void:
	direction = dir

func _ready() -> void:
	# Play sound as soon as the weapon/projectile is spawned/fired
	if weapon_sound:
		weapon_sound.play()

	# Connect area entered signal safely via code
	if not area_entered.is_connected(_on_area_entered):
		area_entered.connect(_on_area_entered)
	if not body_entered.is_connected(_on_body_entered):
		body_entered.connect(_on_body_entered)

func _process(delta: float) -> void:
	if direction != Vector2.ZERO:
		position += direction * speed * delta

func _on_area_entered(area: Area2D) -> void:
	# Check if we hit the enemy's Hitbox area
	if area.name == \"Hitbox\":
		var enemy_node = area.get_parent() # Gets the root 'enemy' node
		if enemy_node and enemy_node.has_method(\"stun\"):
			enemy_node.stun()
		
		# Optional: If you want the projectile to wait for the sound to finish before freeing, 
		# use the safe destroy method below. Otherwise, queue_free() deletes it immediately.
		destroy_projectile()

func _on_body_entered(body: Node2D) -> void:
	# Fallback if enemy body itself is hit
	if body.name == \"enemy\" or body.is_in_group(\"enemy\"):
		if body.has_method(\"stun\"):
			body.stun()
		destroy_projectile()

func destroy_projectile() -> void:
	# Hides sprite and disables collision so it stops interacting, 
	# but lets the sound finish playing if it's still going
	$CollisionShape2D.set_deferred(\"disabled\", true)
	hide()
	
	if weapon_sound and weapon_sound.playing:
		await weapon_sound.finished
		
	queue_free()
"

